# Copy to .env and fill in. The app works without an API key (AI features fall back to offline mode).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Leave empty to auto-generate a persistent secret in backend/data/secret.key
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
# Hours a doctor keeps access after entering Patient ID + PIN
ACCESS_HOURS=2
